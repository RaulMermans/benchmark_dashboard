{
  "name": "benchmark-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio-ready benchmark intelligence dashboard with synthetic raw data and local scenario forecasts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaulMermans/benchmark_dashboard.git"
  },
  "keywords": [
    "benchmark",
    "dashboard",
    "market-share",
    "forecasting",
    "business-intelligence",
    "vite",
    "react"
  ],
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "validate:data": "node scripts/validate-data.mjs",
    "audit:public": "node scripts/audit-public-ready.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  }
}
